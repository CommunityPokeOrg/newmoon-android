DEFINES['_GNU_SOURCE'] = True
DEFINES['IMPL_MFBT'] = True

DISABLE_STL_WRAPPING = True

LOCAL_INCLUDES += [
    '!/xpcom',
    '/memory/build',
]

if CONFIG['MOZ_MIMALLOC']:
    LOCAL_INCLUDES += ['/memory/mimalloc/include']

SOURCES += [
    'mozalloc_ops.cpp',
    'mozalloc_xul.cpp',
]

FINAL_LIBRARY = 'memory'

Library('mozalloc_xul')
