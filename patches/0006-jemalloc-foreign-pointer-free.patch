+/*
+ * The malloc() family that libxul exports is also reachable for pointers
+ * that jemalloc did not allocate: other DSOs in the process (libnspr4,
+ * libnss3, Bionic and system libraries) resolve malloc() to Bionic's
+ * allocator, and buffers they produce can later be passed to libxul's
+ * exported free() or realloc().  Dereferencing the would-be chunk header
+ * of a foreign pointer crashes when it lands on an unmapped page —
+ * observed on Android builds that use 16 KB pages, where Bionic's Scudo
+ * allocator holds its primary heap in a large PROT_NONE reserve.
+ *
+ * jemalloc records every chunk it allocates (arena and huge alike) in
+ * chunk_rtree, which can be queried without dereferencing the chunk
+ * itself, so a pointer with no chunk entry cannot have come from
+ * jemalloc.  Such pointers are handed back to Bionic's allocator.
+ */
+static void	(*jemalloc_libc_free)(void *);
+static void	*(*jemalloc_libc_realloc)(void *, size_t);
+static volatile bool	jemalloc_libc_resolved;
+
+static bool
+jemalloc_resolve_libc(void)
+{
+	void *handle;
+
+	if (!jemalloc_libc_resolved) {
+		handle = dlopen("libc.so",
+		    RTLD_NOW | RTLD_LOCAL | RTLD_NOLOAD);
+		if (handle == NULL)
+			handle = dlopen("libc.so", RTLD_NOW | RTLD_LOCAL);
+		if (handle != NULL) {
+			jemalloc_libc_realloc =
+			    (void *(*)(void *, size_t))
+			    dlsym(handle, "realloc");
+			jemalloc_libc_free =
+			    (void (*)(void *))dlsym(handle, "free");
+		}
+		jemalloc_libc_resolved = true;
+	}
+	return (jemalloc_libc_free != NULL);
+}
+
+static inline bool
+jemalloc_foreign_ptr(const void *ptr)
+{
+	return (chunk_rtree == NULL ||
+	    malloc_rtree_get(chunk_rtree,
+	    (uintptr_t)CHUNK_ADDR2BASE(ptr)) == NULL);
+}
+#endif /* ANDROID */
