diff --git a/config/config.mk b/config/config.mk
index 7425a16435..7400dd8075 100644
--- a/config/config.mk
+++ b/config/config.mk
@@ -261,6 +261,18 @@ CFLAGS		= $(OS_CPPFLAGS) $(OS_CFLAGS)
 CXXFLAGS	= $(OS_CPPFLAGS) $(OS_CXXFLAGS)
 LDFLAGS		= $(OS_LDFLAGS) $(MOZBUILD_LDFLAGS) $(MOZ_FIX_LINK_PATHS)
 
+# mozglue's custom linker loads the packaged .so files itself, so nothing
+# may depend on libc++_shared.so (the 2019 port used a static STL too).
+ifeq (Android,$(OS_TARGET))
+LDFLAGS		+= -static-libstdc++
+# Keep each library's embedded libc++/libunwind symbols private: when
+# dependent libs' UNDEF STL refs bind to another .so's embedded copy, buffers
+# allocated inside that copy use the WRONG allocator (bionic vs jemalloc) and
+# free() crosses the boundary -> crash. Forcing every .so to pull its own
+# archive members makes STL allocation self-consistent.
+LDFLAGS		+= -Wl,--exclude-libs,libc++_static.a -Wl,--exclude-libs,libc++abi.a -Wl,--exclude-libs,libunwind.a
+endif
+
 ifdef MOZ_OPTIMIZE
 ifeq (1,$(MOZ_OPTIMIZE))
 ifneq (,$(if $(MOZ_PROFILE_GENERATE)$(MOZ_PROFILE_USE),$(MOZ_PGO_OPTIMIZE_FLAGS)))
